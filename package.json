{
  "name": "nxmusic",
  "version": "1.0.0",
  "private": true,
  "description": "NX Music Discord music bot",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "register": "node src/deploy-commands.js",
    "test": "node --check src/index.js && node --check src/bot.js && node --check src/services/YouTube.js && node --check src/services/Runtime.js && node --check scripts/update-ytdlp.js",
    "update-ytdlp": "node scripts/update-ytdlp.js",
    "postinstall": "node scripts/update-ytdlp.js"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@distube/ytdl-core": "^4.16.12",
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "ffmpeg-static": "5.3.0",
    "opusscript": "0.0.8",
    "youtube-dl-exec": "^3.1.6"
  }
}
